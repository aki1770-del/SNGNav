# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
/coverage/
packages/*/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Offline map tiles (large binary — see README for generation instructions)
data/*.mbtiles

# Flutter metadata
.flutter-plugins
.metadata

# Flutter ephemeral plugin symlinks
linux/flutter/ephemeral/

# Package lock files (packages are libraries — consumers resolve deps)
packages/*/pubspec.lock

# Lock file — kept for the app (reproducible builds)
# Uncomment if publishing the app as a package:
# pubspec.lock
data/routing/

# Render-capture artifacts (generated by the *_capture tests so a human can
# eyeball output; the tests recreate them — do not version the PNGs)
test/**/_capture/

# Scratch proof/verification dumps (large raw fetches + ad-hoc captures)
.sde_realdata_proof/

# λ-RLM winter-knowledge: UN-PARKED 2026-06-17 (viability condition met). The
# offline cards are now grounded (action-focused CC BY-SA corpus + single-pass
# synthesis — see tool/winter_knowledge/), referenced by the pre-trip briefing
# card, tested, and render-verified. Heavy/regenerable build intermediates stay
# out of source control:
tool/winter_knowledge/corpus.txt
tool/winter_knowledge/corpus_v2.txt
tool/winter_knowledge/corpus_v3.txt
tool/winter_knowledge/cards_raw.json
tool/winter_knowledge/cards_v3.json
tool/winter_knowledge/cards_v4_raw.json
