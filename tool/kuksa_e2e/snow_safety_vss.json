{
  "Vehicle": {
    "type": "branch",
    "description": "Minimal snow-safety VSS overlay for the KUKSA e2e proof.",
    "children": {
      "Speed": {
        "type": "sensor",
        "datatype": "float",
        "unit": "km/h",
        "description": "Vehicle speed. VSS v6.0: float, unit km/h."
      },
      "Exterior": {
        "type": "branch",
        "description": "Exterior conditions.",
        "children": {
          "AirTemperature": {
            "type": "sensor",
            "datatype": "float",
            "unit": "Celsius",
            "description": "Ambient outside air temperature. VSS v6.0: float, unit Celsius."
          }
        }
      },
      "ADAS": {
        "type": "branch",
        "description": "ADAS systems.",
        "children": {
          "ESC": {
            "type": "branch",
            "description": "Electronic Stability Control.",
            "children": {
              "RoadFriction": {
                "type": "branch",
                "description": "Road friction estimate.",
                "children": {
                  "MostProbable": {
                    "type": "sensor",
                    "datatype": "float",
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "description": "Most probable road friction. VSS v6.0: unit percent, 0-100. 0 = no friction, 100 = maximum friction. NOT a 0.0-1.0 fraction."
                  },
                  "LowerBound": {
                    "type": "sensor",
                    "datatype": "float",
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "description": "Lower bound of the friction confidence interval. VSS v6.0: percent 0-100."
                  }
                }
              }
            }
          },
          "TCS": {
            "type": "branch",
            "description": "Traction Control System.",
            "children": {
              "IsEngaged": {
                "type": "sensor",
                "datatype": "boolean",
                "description": "TCS currently engaged."
              }
            }
          },
          "ABS": {
            "type": "branch",
            "description": "Anti-lock Braking System.",
            "children": {
              "IsEngaged": {
                "type": "sensor",
                "datatype": "boolean",
                "description": "ABS currently engaged."
              }
            }
          }
        }
      },
      "Body": {
        "type": "branch",
        "description": "Body signals.",
        "children": {
          "Windshield": {
            "type": "branch",
            "description": "Windshield.",
            "children": {
              "Front": {
                "type": "branch",
                "description": "Front windshield.",
                "children": {
                  "Wiping": {
                    "type": "branch",
                    "description": "Front wiping.",
                    "children": {
                      "Intensity": {
                        "type": "actuator",
                        "datatype": "int32",
                        "_vssDeviation": "datatype: VSS v6.0 declares uint8. Our overlay declares int32 because kuksa_dart_sdk cannot publish an unsigned value through its public API: publishValue() maps every Dart int to Value(int32:), and the documented escape publishDatapoint() takes a generated proto type the package does not export. MEASURED 2026-08-26 against kuksa-databroker 0.7.0, which rejected the VSS-faithful declaration with 'INVALID_ARGUMENT: Wrong type provided'. This deviation is the SDK gap made visible; remove it when the SDK can express uint8.",
                        "description": "Requested relative wiper intensity. VSS v6.0 declares this an ACTUATOR, uint8, with no maximum (\"vehicle specific\"). A weak precipitation proxy."
                      }
                    }
                  }
                }
              }
            }
          },
          "Raindetection": {
            "type": "branch",
            "description": "Rain detection.",
            "children": {
              "Intensity": {
                "type": "sensor",
                "datatype": "int32",
                "unit": "percent",
                "max": 100,
                "_vssDeviation": "datatype: VSS v6.0 declares uint8. Our overlay declares int32 because kuksa_dart_sdk cannot publish an unsigned value through its public API: publishValue() maps every Dart int to Value(int32:), and the documented escape publishDatapoint() takes a generated proto type the package does not export. MEASURED 2026-08-26 against kuksa-databroker 0.7.0, which rejected the VSS-faithful declaration with 'INVALID_ARGUMENT: Wrong type provided'. This deviation is the SDK gap made visible; remove it when the SDK can express uint8.",
                "description": "Rain intensity. VSS v6.0: percent, max 100. 0 = dry, 100 = covered."
              }
            }
          }
        }
      },
      "Chassis": {
        "type": "branch",
        "description": "Chassis.",
        "children": {
          "Axle": {
            "type": "branch",
            "description": "Axle.",
            "children": {
              "Row1": {
                "type": "branch",
                "description": "Row 1.",
                "children": {
                  "Wheel": {
                    "type": "branch",
                    "description": "Wheel.",
                    "children": {
                      "Left": {
                        "type": "branch",
                        "description": "Left wheel.",
                        "children": {
                          "Tire": {
                            "type": "branch",
                            "description": "Tire.",
                            "children": {
                              "Pressure": {
                                "type": "sensor",
                                "datatype": "uint16",
                                "unit": "kPa",
                                "description": "Front-left tire pressure. VSS v6.0: uint16, unit kPa."
                              }
                            }
                          }
                        }
                      },
                      "Right": {
                        "type": "branch",
                        "description": "Right wheel.",
                        "children": {
                          "Tire": {
                            "type": "branch",
                            "description": "Tire.",
                            "children": {
                              "Pressure": {
                                "type": "sensor",
                                "datatype": "uint16",
                                "unit": "kPa",
                                "description": "Front-right tire pressure. VSS v6.0: uint16, unit kPa."
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
